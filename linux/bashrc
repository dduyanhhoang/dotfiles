# Enable the subsequent settings only in interactive sessions
case $- in
  *i*) ;;
    *) return;;
esac

# Oh My Bash. Defaults are fine; see ~/.oh-my-bash/templates/bashrc.osh-template
# for every knob this file deliberately does not repeat.
export OSH="$HOME/.oh-my-bash"
OSH_THEME="robbyrussell"
OMB_USE_SUDO=true
completions=(git composer ssh)
aliases=(general)
plugins=(git bashmarks)

# Guarded: sync.sh apply can land this file before the Oh My Bash installer has
# run (fresh machine), and an unguarded source errors on every shell start.
# See linux/packages.md for the installer.
[[ -r $OSH/oh-my-bash.sh ]] && source "$OSH"/oh-my-bash.sh

# --- User customizations (restored from pre-oh-my-bash .bashrc) ---
export PATH="$HOME/.local/bin:$PATH"

# Ubuntu default aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

# --- WSL: lọc bớt PATH Windows (giữ allowlist bên dưới) ---
# WSL nuốt nguyên PATH của Windows. 15 entry trên 9p filesystem làm
# tab-completion chậm, và scoop/shims + volta shadow các tool Linux cùng tên.
if [[ -n ${WSL_DISTRO_NAME:-} ]]; then
  # Glob patterns, matched case-insensitively against the lowercased entry --
  # `?` covers a different drive letter, `*` a different Windows account.
  _win_keep=(
    '/mnt/?/windows/system32'                                 # clip.exe, cmd.exe, wsl.exe, where.exe
    '/mnt/?/windows/system32/windowspowershell/v1.0'          # powershell.exe
    '/mnt/?/users/*/appdata/local/microsoft/windowsapps'      # wt.exe, winget.exe
    '/mnt/?/users/*/scoop/apps/vscode/current/bin'            # code
    '/mnt/?/users/*/appdata/local/programs/warp/bin'          # warp
    '/mnt/?/users/*/appdata/local/programs/openai/codex/bin'  # codex
  )
  _new_path=
  IFS=: read -ra _parts <<< "$PATH"
  for _p in "${_parts[@]}"; do
    if [[ ${_p,,} == /mnt/* ]]; then
      _hit=
      _pl=${_p,,}; _pl=${_pl%/}
      for _k in "${_win_keep[@]}"; do
        _k=${_k%/}
        # unquoted on purpose: this is a glob match, not a string compare
        [[ $_pl == $_k ]] && _hit=1 && break
      done
      [[ $_hit ]] || continue
    fi
    _new_path=${_new_path:+$_new_path:}$_p
  done
  PATH=$_new_path
  unset _win_keep _new_path _parts _p _pl _k _hit
fi

# --- Neovim qua bob (bob use <ver> / bob update --all) ---
export PATH="$HOME/.local/share/bob/nvim-bin:$PATH"

# --- CLI tools (từ dotfiles repo) ---
# Ubuntu đóng gói bat/fd dưới tên khác để tránh trùng, nên alias lại.
command -v batcat  >/dev/null && alias bat='batcat'
command -v fdfind  >/dev/null && alias fd='fdfind'
command -v eza     >/dev/null && { alias ls='eza --group-directories-first'; alias ll='eza -la --group-directories-first --git'; alias lt='eza --tree --level=2'; }
command -v zoxide  >/dev/null && eval "$(zoxide init bash)"
command -v fzf     >/dev/null && eval "$(fzf --bash)"
